; OpenGenesisLINK G1 – allgemeine Standalone-Referenz (kein Stadt-NexVerse-Deployment).
; Nicht den produktiven Hypergrid-/NodeAgent-/Portal-Stand ueberschreiben.
; Geerbte Defaults werden nur bei abweichendem Betriebsbedarf angepasst.
; Erläuterungen und kritische Werte: doc/OpenGenesisLINK/G1_CONFIG_AUDIT.md
; OpenGenesisLINK 0.9.3.10 compact simulator INI
; Active overrides only. Defaults in OpenSimDefaults.ini / config-include/*.ini.
; Runtime secrets and instance state must not be committed.

[NexVerseNodeAgent]
    Enabled = true
    NodeId = ""
    PeerUrl = "${Environment|NEXVERSE_NEXBUS_PEER_URL}"
    SharedKey = "${Environment|NEXVERSE_NEXBUS_SHARED_KEY}"
    ; Daily OpenSim_<dd_MM_yyyy>.log is forwarded automatically to ROBUST
    ; as signed NexBus chunks. This contains sensitive diagnostics:
    ; only enable for trusted peers reachable over HTTPS.
    ; ROBUST stores OpenSim_<NodeId>_<dd_MM_yyyy>.log under bin/logs.
    LogForwardingEnabled = true
    InboundPath = "/internal/nexbus/v1/events"
    HeartbeatSeconds = 30
    QueueCapacity = 2048
    RequestTimeoutMilliseconds = 2000
    DeduplicationWindow = 10000
    CrossRegionObjectMessaging = true
    CrossRegionChatMessaging = true
    AllowCrossOwnerObjectMessages = true
    EstateScriptMessaging = true
    ; Generation 1: explicit opt-in for global cross-estate object signals.
    ; llGridSay is restricted to Estate Owner/Manager-owned source objects.
    GridScriptMessaging = true
    ObjectMessagesPerSecond = 20
    ObjectMessageMaxAgeSeconds = 30
    ManagedRegionCommands = false
    ; Official GitHub main => separate staging only; no service restart/INI overwrite.
    ; Requires NexBus and simulators:manage authorization at ROBUST.
    UpdateStagingEnabled = false
    UpdateStagingRoot = "/opt/opengenesislink-updates"
    UpdateStagingBuild = true
    ManagedRegionConfigDirectory = "Regions/NexVerseManaged"
    ManagedRegionInternalAddress = "0.0.0.0"
    ManagedRegionExternalHostName = ""
    ManagedRegionType = "NexVerse Managed"
    ManagedRegionPortMin = 9300
    ManagedRegionPortMax = 9399

[OpenGenesisLINKOAR]
    Enabled = true
    StorageRoot = "OGLArchives"
    MaximumArchiveMiB = 20480
    MigrationStorageId = ""

[Const]
    BaseHostname = "127.0.0.1"
    BaseURL = http://${Const|BaseHostname}
    PublicPort = "9000"
    PrivURL = ${Const|BaseURL}
    PrivatePort = "8003"

[OGLMeshLandImpact]
    Enabled = false
[Startup]
    ; OGL 0.9.3.13: erweiterte Sicht auf mehr als das bisherige 3x3-Raster.
    ; Opt-in: angepasste Defaults MaxDrawDistance=1024 und
    ; MaxRegionsViewDistance=768; Standard bleibt 512 / 255.
    ; Firestorm muss eine ausreichend hohe Sichtweite (z. B. 512 m) einstellen.
    ; Hohe Sichtweite steigert Child-Agent-, Netzwerk- und Renderlast.
    ; Erst nach Firestorm-/VarRegion-/Hypergrid-Staging-Abnahme aktivieren!
    OGLExtendedRegionVisibility = false
    ; MaxDrawDistance = 1024
    ; MaxRegionsViewDistance = 768
    ; MinRegionsViewDistance = 96

    ; IAR-Fortschritt live neben der lokalen Konsolen-Eingabe anzeigen.
    ; Remote-Konsole: show iar progress (manuelle Live-Abfrage).
    OGLIarLiveProgress = true
    meshing = Meshmerizer
    physics = BulletSim
    EnableCertConverter = false
    PemCertPublicKey = ""
    PemCertPrivateKey = ""
    outputCertName = "letsencrypt"
    outputCertPassword = ""
    EnableSelfsignedCertSupport = false
    CertRenewOnStartup = false
    CertFileName = "OpenSim"
    CertPassword = "mycertpass"
    CertHostName = "myRegionsExternalHostName"
    CertHostIp = "127.0.0.1"

[AccessControl]
    ; Generation 1 viewer admission: local login, Hypergrid arrival and region entry.
    ; Approved viewers: Firestorm, OpenGenesisLINK/OGL, Radegast-ng, WolfViewer-Release, Frivolin Viewer.
    ; Unknown, Darkstorm, Hydrastorm and other nonapproved viewer names are refused.
    ; WARNING: viewer-reported channel/version can be spoofed. Not DRM or proof of identity.
    OGLApprovedViewersOnly = true


[Map]
    GenerateMaptiles = true
    ; OGL FastMap 2.0: opt in after testing (keep true for normal map rendering).
    FastMapAsyncStartup = false
    FastMapStartupDelaySeconds = 45
    MapImageModule = "Warp3DImageModule"
    TextureOnMapTile = true
    DrawPrimOnMapTile = true
    TexturePrims = true
    RenderMeshes = true
    ; Optional Warp3D world-map Z limit, measured in absolute region meters:
    ; RenderMaxHeight = 500

[Permissions]
    automatic_gods = false
    implicit_gods = false
    allow_grid_gods = true

[Estates]
; EstateModule: Port=0 nutzt Simulator-HTTP-Port. Token nie in Git speichern.
; Handler nicht ohne Estate-API-/Firewall-Tests umstellen.
    EstateCommunicationsHandler = "EstateModule"
    Port = 0

[SMTP]
; LSL-Mail ist unabhaengig vom Offline-IM-Mailrelay.
; Bis zur Einrichtung eines gesicherten SMTP-Dienstes ausgeschaltet.
    enabled = false

[Network]
    http_listener_port = 9000
    ExternalHostNameForLSL = ${Const|BaseHostname}
    shard = "OpenSim"

; Port 0 selects a free TCP port when Enabled=true.
[NexVerseAutoPorts]
    Enabled = false
    HttpPortMin = 9000
    HttpPortMax = 9099

[XMLRPC]
    XmlRpcRouterModule = "XmlRpcRouterModule"
    XmlRpcPort = 20800

[ClientStack.LindenUDP]
; Gepruefte Code-Defaults fuer Viewer-UDP, Texture-Limits und ACKs.
; Nur nach Bandbreiten-/Paketverlusttests abweichend konfigurieren.
    scene_throttle_max_bps = 6250000
    TextureSendLimit = 20
    AckTimeout = 60
    PausedAckTimeout = 300

[ClientStack.LindenCaps]
    Cap_GetTexture = "localhost"
    Cap_GetMesh = "localhost"
    Cap_AvatarPickerSearch = "localhost"
    Cap_GetDisplayNames = "localhost"
    Cap_SetDisplayName = "localhost"

[SimulatorFeatures]
    SearchServerURI = "https://stadt-nexverse.de/service/search?q=[QUERY]&type=[TYPE]&maturity=[MATURITY]"
    DestinationGuideURI = "https://stadt-nexverse.de/service/destination"

[Chat]
; Lokale Chat-Reichweite in Metern.
    enabled = true
    whisper_distance = 10
    say_distance = 20
    shout_distance = 100

[EntityTransfer]
; Regions-/Hypergrid-Wechsel, fuer mehrere Simulatoren nicht deaktivieren.
    AllowAvatarCrossing = true
    DisableObjectTransfer = false
    LevelHGTeleport = 0
    DisableInterRegionTeleportCancellation = false
    LandingPointBehavior = LandingPointBehavior_OS

[Messaging]
    OfflineMessageModule = "Offline Message Module V2"

[OfflineIMEmail]
    Enabled = true
    RelayDomain = "im.stadt-nexverse.de"
    SubjectTemplate = "Offline-IM Nachricht von {SENDER}"
    RelaySigningKey = "${Environment|NEXVERSE_IM_RELAY_SIGNING_KEY}"
    ReplyLifetimeDays = 5
    SMTPHost = "web01.nexvortex.de"
    SMTPPort = 587
    UseStartTls = true
    UseSslOnConnect = false
    SMTPUsername = "relay@im.stadt-nexverse.de"
    SMTPPassword = "${Environment|NEXVERSE_OFFLINE_IM_SMTP_PASSWORD}"
    PerSenderPerHour = 30
    PerRecipientPerHour = 60
    GlobalPerHour = 500

[BulletSim]
    AvatarToAvatarCollisionsByDefault = true

[Wind]
; Einfacher Simulatorwind, NICHT OpenGenesisLINK (OGLWeather).
    enabled = true
    wind_update_rate = 150
    wind_plugin = SimpleRandomWind
    strength = 1.0

[Materials]
; Viewer-Materialien, inklusive Firestorm; Standardlimit.
    enable_materials = true
    MaxMaterialsPerTransaction = 50

[DataSnapshot]
; Legacy-Snapshot-Suche standardmaessig deaktiviert.
; Datenexposition erst nach gesonderter Datenschutzpruefung aktivieren.
    index_sims = false
    data_exposure = minimum
    gridname = "OpenSim"
    default_snapshot_period = 1200
    snapshot_cache_directory = "DataSnapshot"

[Economy]
    economymodule = NexVerseMoneyModule

; OGL Viewer Advisor: opt-in recommendation for users of other viewers.
; The module is intentionally disabled until explicitly enabled.
[OGLViewerAdvisor]
    Enabled = false
    IntervalMinutes = 60
    OfficialViewerPrefixes = "OpenGenesisLINK;OGL Viewer"
    Message = "Um das volle Erlebnis von OpenGenesisLINK geniessen zu koennen, steigen Sie auf den offiziellen OGL Viewer um: https://opengenesislink.de"

[NexDiscoveryViewer]
    Enabled = true
    LegacyFirestormCompatibility = true
    WorldApiBaseUrl = "${Const|BaseURL}:${Const|PublicPort}"
    ; Dedicated backend-only groups:read machine key, created in the World API.
    ; Without it, the Firestorm group land tab sees local simulator regions only.
    GroupLandApiKey = "${Environment|NEXVERSE_GROUP_LAND_API_KEY}"
    RequestTimeoutMilliseconds = 3000

[NexExperiencesViewer]
    ; 0.9.3.10 stabilization: Firestorm Experiences are not released.
    ; Preserve implementation/tests but do not advertise viewer CAPS or consent.
    ; A later own-viewer 2.0 scope may be explicitly planned.
    Enabled = false
    WorldApiBaseUrl = "https://world.stadt-nexverse.de"
    ApiKey = "${Environment|NEXVERSE_EXPERIENCES_API_KEY}"
    RequestTimeoutMilliseconds = 3000
    FirestormReadCaps = true
    FirestormPermissionCaps = true
    ScriptPendingConsent = true
    NativeExperiencePrompt = true
    ViewerPermissionsApiKey = "${Environment|NEXVERSE_EXPERIENCES_VIEWER_PERMISSIONS_API_KEY}"
    FirestormManageCaps = true
    ViewerManageApiKey = "${Environment|NEXVERSE_EXPERIENCES_VIEWER_MANAGE_API_KEY}"

[NexEconomyViewer]
    Enabled = true
    WorldApiBaseUrl = "https://world.stadt-nexverse.de"
    ApiKey = "${Environment|NEXVERSE_ECONOMY_API_KEY}"
    FeeWalletId = ""
    UploadCharge = 0
    GroupCreationCharge = 0
    RequestTimeoutMilliseconds = 3000
    BalanceRefreshSeconds = 5
    ; Enable NV$ wallets for authenticated Hypergrid visitors. No foreign-grid currency transfer.
    AllowHypergridGuests = true
    MasterBankEnabled = false
    MasterBankAccountId = ""
    MasterBankOperatorId = ""
    MasterBankAuthorizedScripts = ""
    MasterBankMaxPayout = 100
    CurrencyPurchasePortalUrl = ""

[YEngine]
; Standard-Scriptengine. Engine-/Timer-Wechsel kann Scriptstatus brechen.
    Enabled = true
    UseSourceHashCode = true
    MinTimerInterval = 0.1

[XEngine]
    AppDomainLoading = false

[NexPortalIM]
    Enabled = false
    ; When ROBUST and Simulator are separate hosts use the protected HTTPS proxy path.
    IngestUrl = "https://world.stadt-nexverse.de/internal/nexportal/im/v1"
    SharedSecret = "${Environment|NEX_PORTAL_IM_SECRET}"

[OSSL]
    Include-osslDefaultEnable = "config-include/osslDefaultEnable.ini"

[Groups]
    Enabled = true
    Module = "Groups Module V2"
    ServicesConnectorModule = "Groups HG Service Connector"
    LocalService = remote
    GroupsServerURI = "${Const|PrivURL}:${Const|PrivatePort}"
    MessagingEnabled = true
    MessagingModule = "Groups Messaging Module V2"
    NoticesEnabled = true
    MessageOnlineUsersOnly = true

[InterestManagement]
    FastRezNearbyFirst = true

[MediaOnAPrim]
; Media-On-A-Prim wird per Viewer-CAPS bereitgestellt.
    Enabled = true

[NPC]
    ; Private owner NPC directory: requires valid NEX_NPC_INGEST_URL and _SECRET.
    NexNPCSnapshotEnabled = false
    ; Private owner-NPC IM: NEX_NPC_CHAT_INGEST_URL and NEX_NPC_CHAT_SECRET.
    NexNPCChatEnabled = false

[Terrain]
; Erstterrain nur bei neuen Regionen, nicht bei vorhandenen Bauten.
    InitialTerrain = "pinhead-island"
    SendTerrainUpdatesByViewDistance = true
    OglTerrainBrushStrengthMultiplier = 2.0

[LandManagement]
; Parcels/VarRegion: optimierte Layer-Updates und sichtbare Ban-Linien.
    LimitParcelLayerUpdateDistance = true
    ParcelLayerViewDistance = 128
    ShowParcelBansLines = true

[UserProfiles]
    ProfileServiceURL = ${Const|BaseURL}:${Const|PublicPort}

[FirestormBridge]
    Enabled = true

[Textures]
    ; Generation 1: retain superseded dynamic textures briefly so viewer
    ; requests for the previous image do not hit an immediately expired asset.
    ; Bounds protect against a high number of minute-by-minute display updates.
    DynamicTexturePreviousRetentionSeconds = 30
    DynamicTexturePreviousRetentionLimit = 256

[Appearance]
    PersistBakedTextures = true
    ReuseTextures = true
    DelayBeforeAppearanceSend = 1
    DelayBeforeAppearanceSave = 3
    ; OGL FastRez pilot: revert to 4000 on viewer/HG login regressions.
    WearablesRequestDelayMs = 1000
    ResendAppearanceUpdates = false

[XBakes]
; Deaktivierte alte externe Texture-Bake-URL, kein untrusted HTTP.
    URL = ""


; ============================================================================
; Generation 1: explizite, bereits bisher wirksame OpenSimDefaults-Module
; ============================================================================
; Die folgenden Werte sind keine neuen Features. Sie dokumentieren
; Kernmodule, die zuvor ausschliesslich aus OpenSimDefaults.ini erbten.

[RegionReady]
    ; Login erst erlauben, wenn die Region bereit ist (Statuskanal -800).
    ; KRITISCH fuer Regionstart, Nutzeranmeldung und Script-Bereitmeldung.
    enabled = true
    channel_notify = -800
    login_disable = true

[EstateManagement]
    ; Erlaubt autorisierten Estate-Berechtigten einen Regionsneustart.
    ; Nicht mit dem internen (Estates)-Kommunikationshandler verwechseln.
    AllowRegionRestartFromClient = true

[Inventory]
    ; Mehrere zusammengehoerige Objekte werden im Inventar gebuendelt.
    CoalesceMultipleObjectsToInventory = true

[Attachments]
    ; KRITISCH fuer Avatare, Skriptzustand und Inventar-Transfers.
    Enabled = true

[Mesh]
    ; Mesh-Upload erlaubt. Upload-Gebuehren und Land Impact sind separat.
    AllowMeshUpload = true

[PacketPool]
    ; UDP-Objektpuffer werden wiederverwendet; nur nach Profiling aendern.
    RecycleBaseUDPPackets = true

[Monitoring]
    ; Externe bzw. interne Monitoring-/Diagnose-Schnittstellen.
    Enabled = true

[Statistics]
    ; Anzahl Frames fuer die Statistikaggregation.
    NumberOfFrames = 10

[JsonStore]
    ; Legacy JsonStore ist standardmaessig AUS. Aktivierung kann neue
    ; Datenhaltung und OSSL/LSL-Verhaltensweisen erfordern.
    Enabled = false
    EnableObjectStore = false
    MaxStringSpace = 0

[OGLShutdown]
    ; Maximale Wartezeit bis Region-Close/Shutdown (Sekunden).
    ; KRITISCH fuer Evakuierung, Backup und geordnetes Herunterfahren.
    RegionCloseTimeoutSeconds = 180

[Architecture]
    Include-Architecture = "config-include/Standalone.ini"


; ================================================================
; OpenGenesisLINK Feature Control 1.0 - standardmäßig aktiviert
; ================================================================
[OGLFeatureControl]
    ; ES256-Schlüssel auf ROBUST und Simulatoren bereitstellen!
    ; Ohne Schlüssel scheitert der ROBUST-Start; ohne signierte Richtlinie
    ; sperrt der Simulator OAR-/IAR-Operationen (fail-closed).
    Enabled = true
    ; Simulator erhält NUR den öffentlichen ES256-Prüfschlüssel.
    ; Alternativ OGL_FEATURE_PUBLIC_KEY_PEM in der Prozessumgebung setzen.
    PublicKeyPath = "config-include/ogl-feature-public.pem"
    ; NodeID muss zur NodeAgent-NodeId passen.
    ; Zusätzlich NexVerseNodeAgent Enabled=true mit authentifiziertem
    ; NexBus und erreichbarem Robust-Peer konfigurieren.


; Anzeigeoptionen unter (Startup):
; OGLConsoleGermanHelp = true
; OGLConsoleExpertHelp = false

; ============================================================================
; Resident IAR: WebDAV NAS is the default transport. Native archive working
; files are temporary and MUST fit the configured size. The operator IAR
; storage location is not changed automatically.
; Configure the same WebDAV URL and credentials as on ROBUST.
[OpenGenesisLINKIAR]
    Enabled = true
    StorageBackend = "WebDAV"
    NasHost = "10.78.0.4"
    WebDavBaseUrl = ""
    WebDavUsername = ""
    WebDavPasswordFile = ""
    MaximumArchiveMiB = 10240
