<Project>
  <!-- .NET 10 server assemblies must never opt into BinaryFormatter via an
       old generated csproj, even when built without runprebuild.sh.
       Directory.Build.targets is imported after project declarations. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
  </PropertyGroup>
</Project>
