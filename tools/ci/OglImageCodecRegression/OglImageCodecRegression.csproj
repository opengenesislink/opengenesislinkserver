<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../OpenSim/Region/CoreModules/OpenSim.Region.CoreModules.csproj" />
    <Reference Include="System.Drawing.Common">
      <HintPath>../../../bin/System.Drawing.Common.dll</HintPath>
    </Reference>
    <Reference Include="OpenMetaverse">
      <HintPath>../../../bin/OpenMetaverse.dll</HintPath>
    </Reference>
    <!-- OpenMetaverse's own DllmapConfigHelper requires the paired native
         mapping file and architecture-specific library next to the test app. -->
    <None Include="../../../bin/OpenMetaverse.dll.config" Link="OpenMetaverse.dll.config"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../bin/lib64/libopenjpeg-dotnet-x86_64.so"
          Link="lib64/libopenjpeg-dotnet-x86_64.so"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
