# /etc/opengenesislink/ogl-node-updater.env -- chmod 0600, root-owned
# This file is read ONLY by the independent systemd service.
OGL_UPDATER_NODE_ID=v72454
OGL_UPDATER_PORT=19090
OGL_UPDATER_REPO_ROOT=/opt/robust
OGL_UPDATER_BACKUP_ROOT=/opt/ogl-backups
OGL_UPDATER_STATE_DIR=/var/lib/ogl-node-updater
# >= 32 random bytes; the NodeAgent uses the SAME secret via
# OGL_NODE_UPDATER_TOKEN in its process environment.
OGL_UPDATER_TOKEN=
