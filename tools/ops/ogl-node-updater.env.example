# OpenGenesisLINK standalone node updater - example only. NEVER commit real keys.
# Copy to /etc/opengenesislink/updater.env, chmod 600, and set service user.
OGL_UPDATER_ENABLE=0
OGL_UPDATER_NODE_ID=YOUR_NODE_ID
OGL_UPDATER_BIN=/opt/robust/bin
OGL_UPDATER_BIND=127.0.0.1
OGL_UPDATER_PORT=8097
OGL_UPDATER_STATE=/var/lib/opengenesislink-updater
OGL_UPDATER_BACKUP_DIR=/opt/ogl-backups
NEXVERSE_UPDATE_CONTROL_KEY=REPLACE_WITH_SEPARATE_RANDOM_64_CHAR_SECRET
