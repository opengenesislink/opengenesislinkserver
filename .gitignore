# OpenGenesisLINK Generation 1 - source-controlled files only

# Build intermediates and IDE state
**/obj/
.vs/
**/.vs/
*.user
*.suo
.vscode/
.idea/
Makefile.local

# Local Python output
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Operating system / editor temporary files
.DS_Store
Thumbs.db
*~
*.swp
*.swo
*.bak
*.orig
*.rej

# Runtime logs, crash dumps, process state, temp files
*.log
*.log.*
*.pid
*.core
core.*
*.dmp
bin/*.tmp
bin/*.lock
bin/*.out

# Runtime-generated NexVerse identity/auth state and private OIDC keys
bin/data/
data/

# Local runtime secrets
bin/nexverse.local.env
.secrets/

# Mono.Addins registry, temporary map and cache data
bin/addin-db-*/
bin/maptiles/
bin/fsassets/tmp/*
!bin/fsassets/tmp/.gitkeep

# Grid-specific terrain source data and accidental filesystem cache copy
bin/nexverse-deutschland/
bin/opt/

# Optional, pinned external wolfvoice region addon, fetched by operator
/addon-modules/os-webrtc-janus/
