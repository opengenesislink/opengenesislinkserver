# NexVerse repository hygiene

# .NET / MSBuild intermediate output
**/obj/

# IDE-local state
.vs/
**/.vs/
*.user
*.suo

# OS-local metadata
.DS_Store
Thumbs.db

# Runtime-generated NexVerse identity/auth state and private OIDC keys
bin/data/
data/

# Local NexVerse runtime secrets (never commit)
bin/nexverse.local.env
.secrets/

# Runtime-created Mono.Addins registry and map tile cache (never version)
bin/addin-db-*/
bin/maptiles/

# Grid-specific terrain source data and accidental filesystem cache copy
bin/nexverse-deutschland/
bin/opt/

# Optional, pinned external wolfvoice region addon, fetched by operator.
# Do not accidentally vendor its full upstream source or build outputs.
/addon-modules/os-webrtc-janus/
